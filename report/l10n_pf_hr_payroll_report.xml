<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Definition du format papier -->
        <record id="l10n_pf_hr_payroll_paper_bulletin" model="report.paperformat">
            <field name="name">A4 - Bulletin</field>
            <field name="default" eval="False" />
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">15</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="True" />
            <field name="header_spacing">10</field>
            <field name="dpi">90</field>
        </record>

        <!-- Definition du rapport -->
        <record id="action_report_report_l10nfrfichepaye" model="ir.actions.report">
            <field name="name">Bulletin de paie</field>
            <field name="model">hr.payslip</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_pf_hr_payroll.report_fiche_paye</field>
            <field name="report_file">l10n_pf_hr_payroll.report_fiche_paye</field>
            <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="l10n_pf_hr_payroll_paper_bulletin"/>
        </record>
    </data>
</odoo>
